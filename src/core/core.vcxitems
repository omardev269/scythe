<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Label="Globals">
    <MSBuildAllProjects Condition="'$(MSBuildVersion)' == '' Or '$(MSBuildVersion)' &lt; '16.0'">$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <HasSharedItems>true</HasSharedItems>
    <ItemsProjectGuid>{8c103a8a-f53c-4324-a2b0-7edc67475dea}</ItemsProjectGuid>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>%(AdditionalIncludeDirectories);$(MSBuildThisFileDirectory)</AdditionalIncludeDirectories>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ProjectCapability Include="SourceItemsFromImports" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="$(MSBuildThisFileDirectory)..\..\common\core\additional_core_definitions.h" />
    <ClInclude Include="$(MSBuildThisFileDirectory)..\..\common\core\cppstuff.h" />
    <ClInclude Include="$(MSBuildThisFileDirectory)..\..\common\core\platform.h" />
    <ClInclude Include="$(MSBuildThisFileDirectory)..\..\common\core\system_headers.h" />
    <ClInclude Include="$(MSBuildThisFileDirectory)..\..\common\core\types.h" />
  </ItemGroup>
</Project>